---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import { SITE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = "Blog — Sound, Noise & Hearing";
const description =
  "Guides and explainers on measuring sound, protecting your hearing, decibel weighting, calibration, and managing noise at home, work and school.";

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${SITE.name} Blog`,
  url: `${SITE.url}/blog/`,
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    datePublished: p.data.pubDate.toISOString(),
    url: `${SITE.url}/blog/${p.id}/`,
  })),
};
---

<Layout title={title} description={description} path="/blog/" jsonLd={jsonLd}>
  <Section
    as="h1"
    eyebrow="Blog"
    title="Sound, noise & hearing"
    intro="Practical, original guides on measuring and managing the sound around you."
  >
    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        posts.map((post) => (
          <article class="card panel-edge group flex flex-col p-6 transition-colors hover:border-hairline-strong">
            <div class="flex items-center gap-2 text-xs text-ink-tertiary">
              <time datetime={post.data.pubDate.toISOString()}>
                {dateFmt(post.data.pubDate)}
              </time>
              {post.data.tags[0] && (
                <>
                  <span aria-hidden="true">·</span>
                  <span class="text-primary">{post.data.tags[0]}</span>
                </>
              )}
            </div>
            <h2 class="mt-3 text-xl font-medium tracking-tight text-ink">
              <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">
              {post.data.description}
            </p>
            <span class="mt-4 text-sm font-medium text-primary">
              Read article →
            </span>
          </article>
        ))
      }
    </div>
  </Section>
</Layout>

<style>
  article {
    position: relative;
  }
</style>
