---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import DecibelTable from "../components/DecibelTable.astro";
import { SITE } from "../consts";

const title = "Decibel (dB) Chart — Common Sound Levels Compared";
const description =
  "A complete decibel chart of everyday sounds from a whisper to a jet engine, with NIOSH risk categories. Understand what dB levels mean and when noise becomes harmful.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    {
      "@type": "ListItem",
      position: 2,
      name: "Decibel Chart",
      item: `${SITE.url}/decibel-chart/`,
    },
  ],
};
---

<Layout title={title} description={description} path="/decibel-chart/" jsonLd={jsonLd}>
  <Section as="h1" eyebrow="Reference" title="Decibel chart of common sounds">
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
      The decibel (dB) scale is logarithmic: a 10 dB rise sounds about twice as
      loud and represents ten times the sound intensity. This chart maps
      familiar sounds to their approximate levels and flags where hearing risk
      begins.
    </p>

    <div class="mt-10">
      <DecibelTable />
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      <div class="card p-6">
        <p class="font-mono text-2xl font-semibold text-zone-quiet">0–52 dB</p>
        <h2 class="mt-2 text-base font-medium text-ink">Quiet to comfortable</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">
          Safe for unlimited exposure. Libraries, quiet homes and calm offices
          sit here.
        </p>
      </div>
      <div class="card p-6">
        <p class="font-mono text-2xl font-semibold text-zone-high">71–85 dB</p>
        <h2 class="mt-2 text-base font-medium text-ink">Elevated</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">
          Traffic, vacuum cleaners and busy restaurants. Extended exposure
          approaches the recommended limit.
        </p>
      </div>
      <div class="card p-6">
        <p class="font-mono text-2xl font-semibold text-zone-danger">86+ dB</p>
        <h2 class="mt-2 text-base font-medium text-ink">Harmful</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">
          Power tools, concerts and sirens. Hearing protection and limited
          duration are strongly advised.
        </p>
      </div>
    </div>

    <div class="mt-12 max-w-2xl">
      <h2 class="display-tight text-2xl text-ink">How to read the scale</h2>
      <p class="mt-3 text-base leading-relaxed text-ink-muted">
        Because decibels are logarithmic, you cannot simply add them. Two
        identical sources together add about 3 dB, not double the number. This
        is also why a small increase on the meter represents a large jump in
        actual energy — and why the safe exposure time falls so quickly as
        levels rise.
      </p>
      <a href="/safe-exposure-calculator/" class="btn btn-secondary mt-6">
        Calculate your safe exposure time →
      </a>
    </div>
  </Section>
</Layout>
