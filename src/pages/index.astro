---
import Layout from "../layouts/Layout.astro";
import Home from "../components/Home.astro";
import { SITE } from "../consts";
import { DEFAULT_LOCALE } from "../i18n/config.mjs";
import { useTranslations } from "../i18n/utils";

const lang = DEFAULT_LOCALE;
const t = useTranslations(lang);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: SITE.name,
    url: SITE.url,
    applicationCategory: "UtilityApplication",
    operatingSystem: "Any (web browser)",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    description: SITE.description,
    featureList: [
      "Real-time decibel measurement",
      "A, C and Z frequency weighting",
      "Fast and Slow time response",
      "LAeq equivalent continuous level",
      "CSV and PDF export",
      "100% on-device, private",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [1, 2, 3, 4].map((n) => ({
      "@type": "Question",
      name: t(`home.faq.q${n}` as any),
      acceptedAnswer: { "@type": "Answer", text: t(`home.faq.a${n}` as any) },
    })),
  },
];
---

<Layout
  title={t("home.hero.title")}
  description={t("home.hero.subtitle")}
  path="/"
  localized
  jsonLd={jsonLd}
>
  <Home lang={lang} />
</Layout>
