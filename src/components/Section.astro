---
interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  id?: string;
  /** Heading level for the title. Use "h1" for a page's lead section. */
  as?: "h1" | "h2";
  /** Center the heading block. */
  center?: boolean;
  class?: string;
}
const {
  eyebrow,
  title,
  intro,
  id,
  as: Heading = "h2",
  center = false,
  class: cls = "",
} = Astro.props;
---

<section id={id} class:list={["container-page py-16 sm:py-20", cls]}>
  {
    (eyebrow || title || intro) && (
      <div class:list={["max-w-2xl", center && "mx-auto text-center"]}>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {title && (
          <Heading class="display-tight mt-3 text-3xl text-ink sm:text-4xl">
            {title}
          </Heading>
        )}
        {intro && (
          <p class="mt-4 text-base leading-relaxed text-ink-muted sm:text-lg">
            {intro}
          </p>
        )}
      </div>
    )
  }
  <slot />
</section>
