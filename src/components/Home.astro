---
// The localized landing page body, shared by the English `/` route and every
// `/{lang}/` route. All copy comes from the i18n dictionary so a single source
// renders every language. The live meter and the deep reference pages keep
// their own (English) data — see the scope note in src/i18n/ui.ts.
import Section from "./Section.astro";
import SoundMeter from "./SoundMeter.astro";
import DecibelTable from "./DecibelTable.astro";
import { useTranslations } from "../i18n/utils";
import { url } from "../lib/path";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang as any);

const features = [
  { t: t("home.f1.title"), b: t("home.f1.body"), icon: "M3 12h4l3-7 4 14 3-7h4" },
  { t: t("home.f2.title"), b: t("home.f2.body"), icon: "M12 8v4l3 3M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" },
  { t: t("home.f3.title"), b: t("home.f3.body"), icon: "M3 3v18h18M7 14l4-4 3 3 5-6" },
  { t: t("home.f4.title"), b: t("home.f4.body"), icon: "M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" },
  { t: t("home.f5.title"), b: t("home.f5.body"), icon: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" },
  { t: t("home.f6.title"), b: t("home.f6.body"), icon: "M9 17H7A5 5 0 0 1 7 7h2m6 0h2a5 5 0 0 1 0 10h-2M8 12h8" },
];

const health = [
  { t: t("home.h1.title"), b: t("home.h1.body") },
  { t: t("home.h2.title"), b: t("home.h2.body") },
  { t: t("home.h3.title"), b: t("home.h3.body") },
  { t: t("home.h4.title"), b: t("home.h4.body") },
];

const faqs = [
  { q: t("home.faq.q1"), a: t("home.faq.a1") },
  { q: t("home.faq.q2"), a: t("home.faq.a2") },
  { q: t("home.faq.q3"), a: t("home.faq.a3") },
  { q: t("home.faq.q4"), a: t("home.faq.a4") },
];
---

<!-- Hero + tool -->
<Section class="!pt-10 sm:!pt-14">
  <div class="mx-auto max-w-2xl text-center">
    <p class="eyebrow">{t("home.hero.eyebrow")}</p>
    <h1 class="display-tight mt-4 text-balance text-4xl text-ink sm:text-6xl">
      {t("home.hero.title")}
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-pretty text-lg leading-relaxed text-ink-muted">
      {t("home.hero.subtitle")}
    </p>
  </div>

  <div class="mx-auto mt-10 max-w-4xl">
    <SoundMeter />
  </div>

  <p class="mx-auto mt-4 max-w-4xl text-center text-xs text-ink-tertiary">
    {t("home.hero.tip")}
  </p>
</Section>

<!-- Features -->
<Section
  eyebrow={t("home.features.eyebrow")}
  title={t("home.features.title")}
  intro={t("home.features.intro")}
  center
>
  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((f) => (
        <div class="card panel-edge p-6">
          <span class="grid h-10 w-10 place-items-center rounded-lg border border-hairline bg-canvas text-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={f.icon} />
            </svg>
          </span>
          <h3 class="mt-4 text-lg font-medium tracking-tight text-ink">{f.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">{f.b}</p>
        </div>
      ))
    }
  </div>
</Section>

<!-- Decibel reference -->
<Section
  eyebrow={t("home.scale.eyebrow")}
  title={t("home.scale.title")}
  intro={t("home.scale.intro")}
>
  <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_320px]">
    <DecibelTable limit={11} />
    <div class="flex flex-col justify-between gap-6">
      <div class="card panel-edge p-6">
        <h3 class="text-lg font-medium text-ink">{t("home.scale.callout.title")}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted">
          {t("home.scale.callout.body")}
        </p>
      </div>
      <a href={url("/decibel-chart/")} class="btn btn-secondary self-start">
        {t("home.scale.link")}
      </a>
    </div>
  </div>
</Section>

<!-- Health impacts -->
<Section
  eyebrow={t("home.health.eyebrow")}
  title={t("home.health.title")}
  intro={t("home.health.intro")}
  center
>
  <div class="mt-12 grid gap-4 sm:grid-cols-2">
    {
      health.map((h) => (
        <div class="card p-6">
          <h3 class="text-lg font-medium tracking-tight text-ink">{h.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">{h.b}</p>
        </div>
      ))
    }
  </div>
  <p class="mt-6 text-center text-xs text-ink-tertiary">{t("home.health.note")}</p>
</Section>

<!-- FAQ -->
<Section eyebrow={t("home.faq.eyebrow")} title={t("home.faq.title")} center>
  <div class="mx-auto mt-10 max-w-3xl divide-y divide-hairline border-y border-hairline">
    {
      faqs.map((f) => (
        <details class="group">
          <summary class="flex cursor-pointer items-center justify-between gap-4 py-4 text-left font-medium text-ink marker:content-none">
            {f.q}
            <svg class="shrink-0 text-ink-tertiary transition-transform group-open:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </summary>
          <p class="pb-4 text-sm leading-relaxed text-ink-muted">{f.a}</p>
        </details>
      ))
    }
  </div>
  <p class="mt-8 text-center text-sm text-ink-subtle">
    <a class="text-primary hover:underline" href={url("/faq/")}>{t("home.faq.more")}</a>
  </p>
</Section>

<!-- CTA -->
<Section>
  <div class="card panel-edge mx-auto flex max-w-4xl flex-col items-center gap-4 p-10 text-center sm:p-14">
    <h2 class="display-tight text-3xl text-ink sm:text-4xl">{t("home.cta.title")}</h2>
    <p class="max-w-lg text-base text-ink-muted">{t("home.cta.body")}</p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      <a href="#meter" class="btn btn-primary">{t("home.cta.measure")}</a>
      <a href={url("/decibel-chart/")} class="btn btn-secondary">{t("home.cta.chart")}</a>
    </div>
  </div>
</Section>
