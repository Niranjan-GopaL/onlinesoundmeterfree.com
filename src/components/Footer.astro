---
import { FOOTER_SECTIONS, SITE } from "../consts";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-hairline bg-canvas">
  <div class="container-page py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_repeat(3,1fr)]">
      <!-- Brand column -->
      <div class="max-w-xs">
        <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
          <span
            class="grid h-7 w-7 place-items-center rounded-md bg-primary text-on-primary"
            aria-hidden="true"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12h3l3-8 6 16 3-8h3"></path>
            </svg>
          </span>
          <span class="text-[15px] font-semibold tracking-tight text-ink">
            Online<span class="text-ink-subtle">SoundMeter</span>
          </span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-ink-subtle">
          A free, private sound level meter that runs entirely in your browser.
          Audio never leaves your device.
        </p>
      </div>

      {
        FOOTER_SECTIONS.map((section) => (
          <nav aria-label={section.title}>
            <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-tertiary">
              {section.title}
            </h2>
            <ul class="mt-4 space-y-2.5">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-ink-subtle transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-hairline pt-6 text-xs text-ink-tertiary sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.name}. All readings are reference estimates.</p>
      <p>
        Built for accuracy · Sources:
        <a class="hover:text-ink-subtle" href="https://www.cdc.gov/niosh/" rel="nofollow noopener" target="_blank">NIOSH</a>,
        <a class="hover:text-ink-subtle" href="https://www.who.int/" rel="nofollow noopener" target="_blank">WHO</a>,
        <a class="hover:text-ink-subtle" href="https://www.nidcd.nih.gov/" rel="nofollow noopener" target="_blank">NIDCD</a>
      </p>
    </div>
  </div>
</footer>
